<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007_add_manual_penalties" author="jan">
        <createTable tableName="manual_penalty">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="manual_penalty_pkey"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="driver_mapping_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="seconds" type="INTEGER"/>
            <column name="point_deduction" type="INTEGER"/>
            <column name="comment" type="VARCHAR(1000)"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="event_id" baseTableName="manual_penalty"
                                 constraintName="fk_manual_penalty_event" deferrable="false"
                                 initiallyDeferred="false" onDelete="CASCADE" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="event" validate="true"/>

        <addForeignKeyConstraint baseColumnNames="driver_mapping_id" baseTableName="manual_penalty"
                                 constraintName="fk_manual_penalty_driver_mapping" deferrable="false"
                                 initiallyDeferred="false" onDelete="CASCADE" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="driver_mapping" validate="true"/>

        <addColumn tableName="driver_result">
            <column name="raw_total_time" type="DOUBLE"/>
            <column name="raw_position" type="INTEGER"/>
        </addColumn>

        <sql>
            <![CDATA[
            UPDATE driver_result SET raw_total_time = total_time, raw_position = position;
            ]]>
        </sql>
    </changeSet>
</databaseChangeLog>
